#!/bin/sh
# Verify src/vendor/expat matches the pinned upstream release exactly.
# Exits non-zero on any difference. Run from the package root.
set -eu

PROV="src/vendor/PROVENANCE"
[ -f "$PROV" ] || { echo "missing $PROV" >&2; exit 1; }

VERSION=$(awk '/^  Version:/ {print $2}' "$PROV")
EXPECTED=$(awk '/^  SHA-256:/ {print $2}' "$PROV")
URL=$(awk '/^  Tarball:/ {print $2}' "$PROV")

echo "==> pinned Expat $VERSION"
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
FAILURES="$WORK/failures"
: > "$FAILURES"

curl -fsSL -o "$WORK/expat.tar.gz" "$URL"
ACTUAL=$(shasum -a 256 "$WORK/expat.tar.gz" | cut -d' ' -f1)
if [ "$ACTUAL" != "$EXPECTED" ]; then
  echo "FAIL: tarball sha256 mismatch" >&2
  echo "  expected $EXPECTED" >&2
  echo "  actual   $ACTUAL" >&2
  exit 1
fi
echo "==> sha256 matches"

tar xzf "$WORK/expat.tar.gz" -C "$WORK"
SRC="$WORK/expat-${VERSION}"

# Expected basenames, one per line, from the shared manifest.
MANIFEST="$WORK/manifest"
grep -v '^#' tools/expat-files.txt | grep -v '^[[:space:]]*$' > "$WORK/paths"
while read -r f; do basename "$f"; done < "$WORK/paths" | sort > "$MANIFEST"

# 1. Every manifest file must be present and byte-identical.
count=0
while read -r f; do
  b=$(basename "$f")
  if [ ! -f "src/vendor/expat/$b" ]; then
    echo "FAIL: src/vendor/expat/$b is missing" >> "$FAILURES"
  elif ! cmp -s "$SRC/$f" "src/vendor/expat/$b"; then
    echo "FAIL: src/vendor/expat/$b differs from upstream $f" >> "$FAILURES"
  fi
  count=$((count + 1))
done < "$WORK/paths"

# 2. Nothing may be present that upstream did not provide. Build artifacts
#    (*.o, *.so, *.dll, *.dylib) are ignored: R builds in place, so they
#    appear here routinely and are already git-ignored.
for local in src/vendor/expat/*; do
  b=$(basename "$local")
  case "$b" in
    *.o | *.so | *.dll | *.dylib | *.a) continue ;;
  esac
  if ! grep -qx "$b" "$MANIFEST"; then
    echo "FAIL: src/vendor/expat/$b is not in tools/expat-files.txt" >> "$FAILURES"
  fi
done

# 3. Configuration must never be vendored -- it belongs in src/expat_config.h.
if [ -f "src/vendor/expat/expat_config.h" ]; then
  echo "FAIL: an upstream expat_config.h leaked into the vendor tree" >> "$FAILURES"
fi

if [ -s "$FAILURES" ]; then
  cat "$FAILURES" >&2
  echo "==> vendor tree FAILED verification" >&2
  exit 1
fi

echo "==> vendor tree verified clean ($count files, Expat $VERSION)"
