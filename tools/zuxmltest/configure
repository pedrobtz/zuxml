#!/bin/sh
# Resolves the static archive that LinkingTo cannot point at.
#
# LinkingTo gets the *headers* onto the include path by itself. There is no
# equivalent for a library, and the alternatives are worse: $(shell ...) in
# Makevars would force SystemRequirements: GNU make, and an Imports: entry
# would add a runtime dependency the design does not want -- nothing here
# calls R code in zuxml, and the archive is linked in statically, so zuxml
# does not need to be loadable at run time.
#
# This is a copy of zuxlsx's configure on purpose: it is the wiring under
# test, so it has to be the same wiring.
set -eu

: "${R_HOME:?configure must be run by R CMD INSTALL, which sets R_HOME}"
RSCRIPT="${R_HOME}/bin/Rscript"

# The archive installs under lib${R_ARCH}: lib/<arch> where R sets an
# architecture, plain lib/ where it does not. Ask for the arch-specific path
# first and fall back, which is right under either layout, and is how zuxlsx
# resolves both zuxml and zukomp.
lib_dir() {
  "${RSCRIPT}" --vanilla -e "arch <- .Platform\$r_arch; d <- if (nzchar(arch)) system.file('lib', arch, package = '$1') else ''; if (!nzchar(d)) d <- system.file('lib', package = '$1'); cat(d)"
}

ZUXML_LIB=$(lib_dir zuxml)

if [ -z "${ZUXML_LIB}" ] || [ ! -f "${ZUXML_LIB}/libzuxml.a" ]; then
  echo "configure: libzuxml.a was found in neither zuxml/lib/<arch> nor zuxml/lib." >&2
  echo "" >&2
  echo "  zuxmltest links it statically. src/Makevars builds the archive and" >&2
  echo "  src/install.libs.R installs it, so reinstall zuxml from this source" >&2
  echo "  tree. The version is not a reliable test -- 0.1.0 exists both with" >&2
  echo "  and without the archive -- which is why this checks for the file." >&2
  exit 1
fi

sed -e "s|@ZUXML_LIB@|${ZUXML_LIB}|g" src/Makevars.in > src/Makevars

echo "configure: linking ${ZUXML_LIB}/libzuxml.a"
