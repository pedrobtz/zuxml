#!/bin/sh
# Build and exercise both ways another package's C code consumes zuxml, one
# fixture package each:
#
#   tools/zuxmltest   the static archive, exactly as zuxlsx does: LinkingTo
#                     alone, Expat's headers off the LinkingTo include path,
#                     and <pkg>/lib${R_ARCH}/libzuxml.a linked statically by the
#                     fixture's own ./configure. No Imports: entry and no
#                     run-time dependency on zuxml.
#   tools/zuxmltable  the registered table: Imports + LinkingTo, an
#                     importFrom() in NAMESPACE, and every call through
#                     zuxml_api_get(). It calls all 26 members.
#
# Run from the package root.
set -eu
LIB=$(mktemp -d)
trap 'rm -rf "$LIB"' EXIT

# Only $LIB and R's own base library, nothing else. A developer machine
# working on zuxlsx has zuxml in its user library, and R_LIBS does not hide
# that -- it only prepends. Two things go wrong if it stays visible: the
# "zuxml is absent" leg below finds that copy and fails spuriously, and, if
# the install into $LIB ever fails, the fixture's configure resolves its
# archive from the developer's older zuxml instead. Neither shows up on a CI
# runner, which has no other copy. R's base packages live in R_HOME/library,
# which is untouched by these two.
R_LIBS_USER=/nonexistent
R_LIBS_SITE=/nonexistent
export R_LIBS_USER R_LIBS_SITE

echo "==> installing zuxml"
R CMD INSTALL --preclean --no-multiarch --library="$LIB" . >/dev/null

echo "==> the LinkingTo archive and Expat headers are installed"
# lib${R_ARCH}: plain lib/ where R sets no architecture (#42).
ARCH=$(Rscript --vanilla -e 'a <- .Platform$r_arch; if (nzchar(a)) cat("/", a, sep = "")')
for f in "lib${ARCH}/libzuxml.a" include/expat.h include/expat_external.h include/zuxml.h; do
  [ -f "$LIB/zuxml/$f" ] || { echo "FAIL: $f is missing from the installation" >&2; exit 1; }
done

echo "==> the public header must expose no Expat type"
# zuxml.h specifically, not inst/include/ as a whole: since the LinkingTo
# archive was added, an installed zuxml also carries Expat's own headers
# beside it, deliberately. What must stay Expat-free is the wrapper API that
# table consumers compile against.
if grep -nE '\bXML_(Parser|Char|Error|Bool)\b' inst/include/zuxml.h; then
  echo "FAIL: an Expat type reached the public header" >&2
  exit 1
fi

echo "==> zuxml.h compiles cleanly under strict consumer flags"
# Two things are checked, in C and in C++. The first is the header alone,
# with -pedantic: it must be plain C99 and C++11. The second is the resolver
# that ZUXML_DEFINE_API_GET emits, compiled with R's headers the way a table
# consumer compiles it. -pedantic is left off there because R's own headers
# use C11 and C23 features. A warning in that resolver becomes a build
# failure for any consumer that uses -Werror; the direct DL_FUNC cast it used
# to make was one, under clang's -Wcast-function-type.
HDR=$(mktemp -d)
printf '#include "zuxml.h"\n' > "$HDR/pure.c"
cp "$HDR/pure.c" "$HDR/pure.cpp"
cat > "$HDR/resolve.c" <<'EOF'
#include <R.h>
#include <Rinternals.h>
#include <R_ext/Rdynload.h>
#define ZUXML_DEFINE_API_GET
#include "zuxml.h"
const zuxml_api *resolve(void);
const zuxml_api *resolve(void) { return zuxml_api_get(); }
EOF
cp "$HDR/resolve.c" "$HDR/resolve.cpp"
R_CC=$(R CMD config CC)
R_CXX=$(R CMD config CXX)
R_INC=$(R CMD config --cppflags)
STRICT="-Wall -Wextra -Wcast-function-type -Werror"
# Word splitting is wanted below: R CMD config returns a command plus flags.
# shellcheck disable=SC2086
{
  $R_CC -std=c99 -Wall -Wextra -pedantic -Werror -I inst/include \
    -c "$HDR/pure.c" -o "$HDR/pure.o" &&
  $R_CXX -std=c++11 -Wall -Wextra -pedantic -Werror -I inst/include \
    -c "$HDR/pure.cpp" -o "$HDR/pure-cpp.o" &&
  $R_CC $STRICT $R_INC -I inst/include \
    -c "$HDR/resolve.c" -o "$HDR/resolve.o" &&
  $R_CXX $STRICT $R_INC -I inst/include \
    -c "$HDR/resolve.cpp" -o "$HDR/resolve-cpp.o"
} || { rm -rf "$HDR"; echo "FAIL: zuxml.h warns under strict flags" >&2; exit 1; }
# GCC accepts the direct cast even with -Wcast-function-type; only clang
# rejects it. So the resolver is also compiled with clang wherever there is
# one, which includes GitHub's Linux runners, where R's own compiler is GCC.
if command -v clang >/dev/null 2>&1 && command -v clang++ >/dev/null 2>&1; then
  # shellcheck disable=SC2086
  { clang $STRICT $R_INC -I inst/include -c "$HDR/resolve.c" -o "$HDR/r2.o" &&
    clang++ $STRICT $R_INC -I inst/include -c "$HDR/resolve.cpp" -o "$HDR/r3.o"
  } || { rm -rf "$HDR"; echo "FAIL: zuxml.h's resolver warns under clang" >&2; exit 1; }
fi
rm -rf "$HDR"

echo "==> the fixture must not declare a run-time dependency on zuxml"
# The whole point of the archive: if either of these creeps back in, the
# fixture would load zuxml's namespace and stop testing the shape zuxlsx
# actually uses.
if grep -qE '^(Imports|Depends):' tools/zuxmltest/DESCRIPTION; then
  echo "FAIL: zuxmltest declares Imports/Depends; it must link, not load" >&2
  exit 1
fi
if grep -qE '^\s*(import|importFrom)\(' tools/zuxmltest/NAMESPACE; then
  echo "FAIL: zuxmltest imports a namespace; it must link, not load" >&2
  exit 1
fi

# --preclean so ./configure and src/Makevars.in are exercised from scratch on
# every run: a configure that resolves the archive only because a stale
# src/Makevars was left behind is the failure this is here to catch.
echo "==> installing the downstream fixture (configure resolves the archive)"
R_LIBS="$LIB" R CMD INSTALL --preclean --no-multiarch --library="$LIB" \
  tools/zuxmltest >/dev/null

echo "==> Expat must be linked in, not left for the loader"
# This runs before anything is executed because on macOS it is the only thing
# that catches a dropped PKG_LIBS. R links a package .so with
# -undefined dynamic_lookup there, so a consumer that never linked the
# archive still builds, still loads and still parses -- against whatever
# Expat the process happens to have (the system one, via another R library).
# Every assertion below would pass. On Linux and Windows the same mistake
# fails at link time instead.
so=$(find "$LIB/zuxmltest/libs" -name 'zuxmltest.*' | head -1)
if command -v nm >/dev/null 2>&1 && [ -n "$so" ]; then
  u=$(nm -u "$so" 2>/dev/null | grep -c 'XML_' || true)
  [ "$u" = "0" ] || {
    echo "FAIL: $u Expat symbols are undefined in $so." >&2
    echo "  libzuxml.a was not linked in; check PKG_LIBS in src/Makevars.in" >&2
    echo "  and what ./configure substituted into it." >&2
    exit 1
  }
  d=$(nm "$so" 2>/dev/null | grep -c ' [TtDd] _*XML_' || true)
  [ "$d" != "0" ] || { echo "FAIL: no Expat symbols were linked in" >&2; exit 1; }
  echo "==> $d Expat symbols are statically linked into the consumer"
fi

echo "==> exercising the archive from R"
R_LIBS="$LIB" Rscript -e '
  library(zuxmltest)
  stopifnot(grepl("^expat_[0-9]", expat_version()))

  doc <- "<f:a xmlns:f=\"urn:a\"><e id=\"1\">hi</e></f:a>"
  base <- consume_xml(doc)
  # A plain (non-namespace-aware) parser, so xmlns:f counts as an attribute.
  stopifnot(identical(base$status, "ok"), base$elements == 2,
            base$attrs == 2, base$text_bytes == 2)
  for (k in c(1, 2, 3, 7, 31, 4096))
    stopifnot(identical(consume_xml(doc, chunk = k), base))

  bad <- consume_xml("<a><b></a>")
  stopifnot(identical(bad$status, "error"), nzchar(bad$message),
            grepl("[A-Za-z]{4,}", bad$message))
  cat("==> archive consumer parses, chunk-independently\n")
'

echo "==> the fixture loads with zuxml absent from the library path"
# The strongest statement of "no run-time dependency": move the installed
# zuxml out of the way entirely and the consumer must still work, because
# every Expat symbol it needs is inside its own shared object.
mv "$LIB/zuxml" "$LIB/.zuxml-hidden"
R_LIBS="$LIB" Rscript -e '
  # Exactly two: $LIB, and R_HOME/library for the base packages. Any third
  # entry means R_LIBS_USER or R_LIBS_SITE leaked back in and the assertion
  # below would no longer be testing anything.
  stopifnot(length(.libPaths()) == 2L,
            !nzchar(system.file(package = "zuxml")))
  library(zuxmltest)
  stopifnot(identical(consume_xml("<a><b/><c/></a>")$elements, 3))
  cat("==> consumer runs with zuxml uninstalled\n")
'
mv "$LIB/.zuxml-hidden" "$LIB/zuxml"

# ---- the registered table -------------------------------------------------

echo "==> the table fixture must declare the full dependency shape"
# All three are required, and the NAMESPACE directive is the one that gets
# forgotten: Imports: only guarantees zuxml is installed, and R_GetCCallable()
# resolves nothing until zuxml's namespace is loaded (roadmap Stage 6).
grep -qE '^Imports:.*\bzuxml\b' tools/zuxmltable/DESCRIPTION &&
  grep -qE '^LinkingTo:.*\bzuxml\b' tools/zuxmltable/DESCRIPTION &&
  grep -qE '^\s*importFrom\(zuxml,' tools/zuxmltable/NAMESPACE || {
  echo "FAIL: zuxmltable must carry Imports, LinkingTo and importFrom" >&2
  exit 1
}

echo "==> installing the table fixture"
R_LIBS="$LIB" R CMD INSTALL --preclean --no-multiarch --library="$LIB" \
  tools/zuxmltable >/dev/null

echo "==> a table consumer links no Expat and no zuxml symbol"
# Everything goes through the registered table, so nothing of Expat and
# nothing named zux_ may be referenced, let alone defined. As above, this
# matters most on macOS, where an undefined symbol would still load.
so=$(find "$LIB/zuxmltable/libs" -name 'zuxmltable.*' | head -1)
if command -v nm >/dev/null 2>&1 && [ -n "$so" ]; then
  n=$(nm "$so" 2>/dev/null | grep -cE ' _*(XML_|zux_)' || true)
  [ "$n" = "0" ] || {
    echo "FAIL: $n Expat or zux_ symbols in $so; it must use the table" >&2
    exit 1
  }
fi

echo "==> exercising all 26 table members from R"
R_LIBS="$LIB" Rscript -e '
  library(zuxmltable)

  m <- table_members()
  stopifnot(all(m$present), length(m$present) == 26L,
            m$struct_size == m$header_size)

  doc <- paste0("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n",
                "<f:a xmlns:f=\"urn:a\" xmlns=\"urn:d\"><!-- c -->",
                "<e id=\"1\" f:k=\"v&#10;w\">hi &amp; bye</e>",
                "<?pi data?><e/>téxt</f:a>")

  # Streaming, through parser_*: chunk boundaries must not show.
  ev <- table_events(doc)
  stopifnot(identical(ev$status, "ok"), grepl("start {urn:d}e", ev$events,
                                              fixed = TRUE))
  for (k in c(1, 2, 3, 7, 31, 4096))
    stopifnot(identical(table_events(doc, k), ev))

  # The tree, incrementally through tree_begin/feed/end and whole through
  # tree_parse, walked with every accessor: the two must agree, the
  # contracts the header states must hold, and serializing through the table
  # must match what zuxml itself serializes.
  tr <- table_tree(doc)
  stopifnot(identical(tr$status, "ok"), tr$consistent, tr$node_count > 0,
            identical(tr$dump, tr$dump_whole),
            identical(tr$serialized, tr$serialized_whole),
            identical(tr$serialized, as.character(zuxml::xml_parse(doc))))
  for (k in c(1, 2, 3, 7, 31, 4096))
    stopifnot(identical(table_tree(doc, k), tr))

  # Failure part-way through a chunked feed: tree_error must still report
  # where, before tree_abort releases the builder.
  bad <- table_tree("<a>\n<b></a>", 1)
  stopifnot(identical(bad$status, "invalid XML"), nzchar(bad$message),
            bad$line == 2, bad$column == 5)
  bev <- table_events("<a>\n<b></a>", 1)
  stopifnot(identical(bev[c("status", "message", "line", "column")],
                      bad[c("status", "message", "line", "column")]))

  stopifnot(identical(table_abort(doc, 20), "ok"),
            identical(table_abort(doc, 0), "ok"))

  # struct_size against an older zuxml: ZUXML_API_HAS() must see that
  # set_message is missing, and the consumer must fall back.
  d <- table_degrade()
  stopifnot(d$real_has_set_message, d$old_has_serialize,
            !d$old_has_set_message, identical(d$message, "fallback"))
  cat("==> table consumer calls all 26 members, chunk-independently\n")
'
